#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        tab_morph: tab_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "TAB_MORPH";
            bindings = <&kp A>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };

        escp_morph: escp_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "ESCP_MORPH";
            bindings = <&kp Q>, <&kp ESC>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };

        alt_morph: alt_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_MORPH";
            bindings = <&kp Z>, <&kp LEFT_ALT>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };

        a_morph: a_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "A_MORPH";
            bindings = <&kp S>, <&kp A>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        ru_en_toggle: ru_en_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "RU_EN_TOGGLE";
        };

        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "COPY";
        };

        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp V>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "PASTE";
        };

        save: save {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "SAVE";
        };

        revert: revert {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp Z>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "REVERT";
        };

        macro_one: one {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp N1>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "ONE";
        };

        macro_zero: zero {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp N0>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "ZERO";
        };

        next_page: next_page {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "NEXT_PAGE";
        };

        prev_page: prev_page {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LEFT_CONTROL &kp LEFT_SHIFT>;

            label = "PREV_PAGE";
        };

        pop_history: pop_history {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp LEFT_BRACKET>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "POP_HISTORY";
        };

        push_history: push_history {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp RIGHT_BRACKET>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "PUSH_HISTORY";
        };

        macro_two: two {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "TWO";
        };

        select_word: select_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND>,
                <&macro_tap>,
                <&kp D>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "SELECT_WORD";
        };

        macro_c: macro_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "MACRO_C";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &escp_morph  &kp W     &kp F  &kp P             &kp G                          &kp J  &kp L           &kp U      &kp Y    &kp BACKSPACE
  &tab_morph   &a_morph  &kp R  &kp T             &kp D                          &kp H  &kp N           &kp E      &kp I    &kp O
  &alt_morph   &kp X     &kp C  &kp V             &kp B                          &kp K  &kp M           &kp COMMA  &kp DOT  &kp QUESTION
                                &kp LEFT_COMMAND  &mo 1  &kp SPACE    &kp ENTER  &mo 2  &kp LEFT_SHIFT
            >;

            display-name = "Base";
        };

        macros {
            bindings = <
  &kp ESC         &kp HOME      &kp UP    &kp END           &kp PRINTSCREEN                          &kp PAGE_UP    &ru_en_toggle  &none        &kp F12     &kp BACKSPACE
  &kp TAB         &kp LEFT      &kp DOWN  &kp RIGHT         &macro_c                                 &kp PAGE_DOWN  &copy          &paste       &revert     &kp LEFT_CONTROL
  &kp LEFT_SHIFT  &kp LEFT_ALT  &kp CAPS  &kp LEFT_CONTROL  &kp DELETE                               &save          &macro_one     &macro_zero  &macro_two  &trans
                                          &trans            &trans           &trans    &select_word  &mo 3          &trans
            >;

            display-name = "Macros";
        };

        symbols {
            bindings = <
  &kp ESC         &kp LT                &kp EQUAL  &kp GT                 &kp GRAVE                    &kp CARET  &kp LBKT        &kp UNDER  &kp RBKT         &kp BACKSPACE
  &kp TAB         &kp LEFT_PARENTHESIS  &kp MINUS  &kp RIGHT_PARENTHESIS  &kp PLUS                     &kp PRCNT  &kp LEFT_BRACE  &kp SEMI   &kp RIGHT_BRACE  &kp EXCLAMATION
  &kp LEFT_SHIFT  &kp ASTRK             &kp COLON  &kp BACKSLASH          &trans                       &kp SQT    &kp PIPE        &kp TILDE  &kp AMPS         &kp FSLH
                                                   &trans                 &mo 3      &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        numbers {
            bindings = <
  &kp N1          &kp N2        &kp N3  &kp N4         &kp N5                    &kp N6  &kp N7        &kp N8      &kp N9        &kp N0
  &kp TAB         &prev_page    &trans  &next_page     &mo 5                     &mo 4   &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans
  &kp LEFT_SHIFT  &pop_history  &trans  &push_history  &trans                    &trans  &kp C_PREV    &kp C_PP    &kp C_NEXT    &kp LEFT_SHIFT
                                        &trans         &trans  &trans    &trans  &trans  &trans
            >;
        };

        fs {
            bindings = <
  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
  &kp F11  &kp F12  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
  &trans   &trans   &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                            &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        bluetooth {
            bindings = <
  &bootloader  &trans  &trans  &trans  &trans                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
  &trans       &trans  &trans  &trans  &trans                    &out OUT_BLE  &trans        &trans        &trans        &trans
  &trans       &trans  &trans  &trans  &trans                    &out OUT_USB  &trans        &trans        &trans        &studio_unlock
                               &trans  &trans  &trans    &trans  &trans        &trans
            >;

            display-name = "Bluetooth";
        };
    };
};
