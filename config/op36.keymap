#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <240>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        skq: sticky_key_quick {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <2000>;
            quick-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        kha {
            bindings = <&kp LBKT>;
            key-positions = <6 7>;
        };

        hrdsgn {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
        };

        copy {
            bindings = <&kp K_COPY>;
            key-positions = <10 22>;
        };

        paste {
            bindings = <&kp K_PASTE>;
            key-positions = <10 23>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &kp Q        &kp W        &kp E         &kp R          &kp T                                      &kp Y  &kp U         &kp I         &kp O        &kp P
  &hml LGUI A  &hml LALT S  &hml LSHFT D  &hml LCTRL F   &kp G                                      &kp H  &hmr RCTRL J  &hmr RSHFT K  &hmr LALT L  &hmr RGUI SEMICOLON
  &kp Z        &kp X        &kp C         &kp V          &kp B                                      &kp N  &kp M         &kp COMMA     &kp DOT      &kp SQT
                                          &kp BACKSPACE  &skq LEFT_COMMAND  &kp SPACE    &kp ENTER  &mo 1  &tog 4
            >;

            display-name = "Base";
        };

        nav {
            bindings = <
  &kp N1                  &kp N2            &kp N3                &kp N4                    &kp N5                               &kp N6     &kp N7                       &kp N8                    &kp N9                      &kp N0
  &hml LEFT_COMMAND EXCL  &hml LEFT_ALT AT  &hml LEFT_SHIFT HASH  &hml LEFT_CONTROL DOLLAR  &kp PERCENT                          &kp CARET  &hmr LEFT_CONTROL AMPERSAND  &hmr LEFT_SHIFT ASTERISK  &hmr LALT LEFT_PARENTHESIS  &hmr RGUI RIGHT_PARENTHESIS
  &none                   &kp HOME          &kp INS               &kp END                   &kp DELETE                           &kp ESC    &none                        &kp RU_COMMA              &kp RU_DOT                  &kp QUESTION
                                                                  &trans                    &trans       &trans    &kp CAPSLOCK  &mo 3      &trans
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
  &none           &kp HASH        &kp RU_EQUAL        &kp DOLLAR       &kp GRAVE                           &kp CARET  &kp LBKT         &kp RU_UNDERSCORE    &kp RBKT        &none
  &hml LGUI BSLH  &hml LALT LPAR  &hml LSHFT RU_PLUS  &hml LCTRL RPAR  &kp PLUS                            &kp PRCNT  &hmr RCTRL LBRC  &hmr RSHFT RU_MINUS  &hmr LALT RBRC  &hmr RGUI EXCL
  &kp HASH        &kp STAR        &kp COLON           &kp KP_SLASH     &kp RU_BACKSLASH                    &none      &kp PIPE         &kp TILDE            &kp AMPS        &kp DLLR
                                                      &trans           &mo 3             &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
  &kp LG(RU_N1)  &kp LG(RU_N2)  &kp LG(F2)     &kp LG(F3)     &kp LG(F4)                    &kp LG(RU_N6)  &kp LG(RU_N7)        &kp LG(RU_N9)      &bt BT_SEL 0        &bt BT_CLR
  &kp LGUI       &hml LALT F5   &hml LSHFT F6  &hml LCTRL F7  &kp F8                        &out OUT_BLE   &hmr RCTRL C_VOL_DN  &hmr RSHFT C_MUTE  &hmr LALT C_VOL_UP  &kp RGUI
  &none          &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &kp F12                       &out OUT_USB   &kp C_PREV           &kp C_PP           &kp C_NEXT          &studio_unlock
                                               &trans         &trans      &trans    &trans  &trans         &trans
            >;

            display-name = "Adjust";
        };

        game {
            display-name = "Game";
            bindings = <
  &kp Q  &kp W  &kp E  &kp R   &kp T                     &kp Y   &kp U   &kp I      &kp O    &kp P
  &kp A  &kp S  &kp D  &kp F   &kp G                     &kp H   &kp J   &kp K      &kp L    &kp SEMICOLON
  &kp Z  &kp X  &kp C  &kp V   &kp B                     &kp N   &kp M   &kp COMMA  &kp DOT  &kp SQT
                       &trans  &trans  &trans    &trans  &trans  &tog 4
            >;
        };
    };
};
